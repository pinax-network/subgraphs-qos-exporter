{
  "name": "subgraphs-qos-exporter",
  "version": "0.1.0",
  "description": "Prometheus exporter for The Graph's Gateway QoS feed (read straight off the on-chain DataEdge contract, bypassing the stale QoS subgraph)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "gen:deployments": "bun run scripts/gen-deployments.ts",
    "gen:indexers": "bun run scripts/gen-indexers.ts"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/bun": "1.3.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
